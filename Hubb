local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Player = Players.LocalPlayer

local success, Rayfield = pcall(function()
    return loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
end)

if not success or not Rayfield then
    Rayfield = loadstring(game:HttpGet('https://raw.githubusercontent.com/shlexware/Rayfield/main/source'))()
end

local Window = Rayfield:CreateWindow({
   Name = "⚡ Cyber Engine X.8.1 // Train Pets for Eggs",
   LoadingTitle = "Memuat Cyber Engine...",
   LoadingSubtitle = "by Cyber Engine",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false, 
})

local MainTab = Window:CreateTab("🥚 Auto Farm & Egg", 4483362458)
local PlayerTab = Window:CreateTab("🚀 Player & Plot", 4483362458)

local isAutoEgg = false
local isMagnet = false
local isAutoPlot = true
local walkSpeedVal = 16
local lastTeleportTime = 0

MainTab:CreateSection("🥚 Pengumpulan Telur Otomatis")

MainTab:CreateToggle({
   Name = "🥚 Auto Collect Egg (Ambil Sekitar)",
   CurrentValue = false,
   Callback = function(v) isAutoEgg = v end,
})

MainTab:CreateToggle({
   Name = "🧲 Magnet Egg (Tarik Telur)",
   CurrentValue = false,
   Callback = function(v) isMagnet = v end,
})

MainTab:CreateToggle({
   Name = "🏠 Auto Teleport ke Plot Sendiri (Anti-Loop)",
   CurrentValue = true,
   Callback = function(v) isAutoPlot = v end,
})

PlayerTab:CreateSection("🚀 Pengaturan Karakter")

PlayerTab:CreateSlider({
   Name = "WalkSpeed Custom",
   Range = {16, 200},
   Increment = 1,
   CurrentValue = 16,
   Callback = function(v) walkSpeedVal = v end,
})

PlayerTab:CreateButton({
   Name = "🏠 Teleport Instan ke Plot Sendiri",
   Callback = function()
      pcall(function()
         local char = Player.Character
         if not char or not char:FindFirstChild("HumanoidRootPart") then return end
         local hrp = char.HumanoidRootPart
         local targetCFrame = nil
         
         -- Mencari plot spesifik milik player sendiri
         for _, obj in pairs(Workspace:GetDescendants()) do
             pcall(function()
                 if obj and (obj:IsA("BasePart") or obj:IsA("Model")) then
                     local name = obj.Name:lower()
                     if name:find("plot") or name:find("base") then
                         if name:find(Player.Name:lower()) or obj:FindFirstChild(Player.Name) or (obj:FindFirstChild("Owner") and obj.Owner.Value == Player) then
                             local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                             if part and part:IsA("BasePart") then
                                 targetCFrame = part.CFrame * CFrame.new(0, 5, 0)
                             end
                         end
                     end
                 end
             end)
             if targetCFrame then break end
         end

         -- Fallback jika plot spesifik tidak ketemu namanya, cari plot terdekat
         if not targetCFrame then
             for _, obj in pairs(Workspace:GetDescendants()) do
                 pcall(function()
                     if obj and (obj:IsA("BasePart") or obj:IsA("Model")) then
                         local name = obj.Name:lower()
                         if name == "plot" or name == "base" then
                             local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                             if part and part:IsA("BasePart") and (part.Position - hrp.Position).Magnitude < 300 then
                                 targetCFrame = part.CFrame * CFrame.new(0, 5, 0)
                             end
                         end
                     end
                 end)
                 if targetCFrame then break end
             end
         end

         if targetCFrame then
             hrp.CFrame = targetCFrame
             Rayfield:Notify({ Title = "Plot Pribadi", Content = "Berhasil teleport ke plot kamu!", Duration = 2 })
         else
             Rayfield:Notify({ Title = "Plot Gagal", Content = "Plot tidak ditemukan!", Duration = 2 })
         end
      end)
   end,
})

-- Fungsi Mendapatkan Posisi Plot Sendiri
local function getMyPlotPosition()
    local targetCFrame = nil
    pcall(function()
        for _, obj in pairs(Workspace:GetDescendants()) do
            pcall(function()
                if obj and (obj:IsA("BasePart") or obj:IsA("Model")) then
                    local name = obj.Name:lower()
                    if name:find("plot") or name:find("base") then
                        if name:find(Player.Name:lower()) or obj:FindFirstChild(Player.Name) then
                            local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                            if part and part:IsA("BasePart") then
                                targetCFrame = part.CFrame * CFrame.new(0, 5, 0)
                            end
                        end
                    end
                end
            end)
            if targetCFrame then break end
        end

        -- Fallback pencarian plot umum terdekat jika tidak ada nama yang cocok
        if not targetCFrame then
            for _, obj in pairs(Workspace:GetDescendants()) do
                pcall(function()
                    if obj and (obj:IsA("BasePart") or obj:IsA("Model")) then
                        local name = obj.Name:lower()
                        if name == "plot" or name == "base" then
                            local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                            if part and part:IsA("BasePart") then
                                targetCFrame = part.CFrame * CFrame.new(0, 5, 0)
                            end
                        end
                    end
                end)
                if targetCFrame then break end
            end
        end
    end)
    return targetCFrame
end

-- BACKGROUND LOOP DENGAN PENGAMAN ANTI-LOOP & COOLDOWN
RunService.Heartbeat:Connect(function()
    pcall(function()
        local char = Player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        
        if hum then hum.WalkSpeed = walkSpeedVal end

        -- Cek apakah karakter sedang memegang telur (Dengan cooldown 5 detik agar tidak mental/looping)
        if isAutoPlot and hrp and (tick() - lastTeleportTime > 5) then
            local isCarryingEgg = false
            
            for _, child in pairs(char:GetDescendants()) do
                if child:IsA("BasePart") or child:IsA("Model") then
                    local cName = child.Name:lower()
                    if cName:find("egg") or cName:find("telur") or cName:find("hold") or cName:find("carry") then
                        isCarryingEgg = true
                        break
                    end
                end
            end

            if Player.Character:FindFirstChild("Holding") or Player.Character:FindFirstChild("Carrying") then
                isCarryingEgg = true
            end

            if isCarryingEgg then
                local plotPos = getMyPlotPosition()
                if plotPos then
                    -- Set waktu teleport terakhir untuk mencegah loop/bug mental
                    lastTeleportTime = tick()

                    -- Teleport instan ke plot sendiri
                    hrp.CFrame = plotPos
                    
                    Rayfield:Notify({
                        Title = "🥚 Telur Diamankan!",
                        Content = "Berhasil dibawa ke plot pribadi!",
                        Duration = 3,
                    })
                end
            end
        end

        -- Logika Auto Collect & Magnet Egg
        if (isAutoEgg or isMagnet) and hrp then
            for _, obj in pairs(Workspace:GetDescendants()) do
                pcall(function()
                    if obj and (obj:IsA("Model") or obj:IsA("BasePart")) then
                        local name = obj.Name:lower()
                        if (name:find("egg") or name:find("telur") or name:find("nest")) and not name:find("player") then
                            local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                            if part and part:IsA("BasePart") then
                                if (part.Position - hrp.Position).Magnitude < 40 then
                                    if isMagnet then
                                        part.CFrame = hrp.CFrame * CFrame.new(0, 0, -2)
                                    end
                                    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true) or part:FindFirstChildWhichIsA("ProximityPrompt", true)
                                    if prompt and fireproximityprompt then
                                        fireproximityprompt(prompt)
                                    end
                                    if firetouchinterest then
                                        firetouchinterest(hrp, part, 0)
                                        task.wait(0.02)
                                        firetouchinterest(hrp, part, 1)
                                    end
                                end
                            end
                        end
                    end
                end)
            end
        end
    end)
end)

Rayfield:Notify({
   Title = "Cyber Engine Berhasil!",
   Content = "Fitur Plot Pribadi & Anti-Loop Aktif.",
   Duration = 4,
   Image = 4483362458,
})
